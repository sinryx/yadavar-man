<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layoutDirection="rtl"
    android:background="@drawable/w_bg"
    android:padding="6dp">
    <LinearLayout
        android:id="@+id/w_bar"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/w_chat" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="از دستیار بپرس…"
            android:textColor="#55606a"
            android:textSize="15sp"
            android:maxLines="1" />
    </LinearLayout>
    <ImageView
        android:id="@+id/w_mic"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/w_mic_bg"
        android:padding="10dp"
        android:src="@drawable/w_mic"
        android:contentDescription="گفتن با صدا" />
</LinearLayout>
